1. nest new "name project" = สร้างโปรเจคใหม่
2. npm install @nestjs/config = สร้าง.env
3. built file "docker-compose.yml" = สร้างฐานข้อมูล
    3.1 docker compose up -d = สร้างและสตาร์ต container ทุกตัวในไฟล์
    3.2 docker compose down -v = ลบ volume เก่าทิ้งด้วยทั้งหมด
4. npm install typeorm@latest,npm install -D tsx = ตัวเชื่อม DB กับ coding
5. npm run migration:create 'name' = สร้างไฟล์ migration
    5.1 built file "database.config.ts"
    5.2 package.json =
        "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/database/database.config.ts",
        "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create"
